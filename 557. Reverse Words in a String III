class Solution {
    public String reverseWords(String s) {
        StringBuilder res = new StringBuilder();
        StringBuilder temp = new StringBuilder();
        for ( int i = 0;i<s.length();i++){
            if(s.charAt(i)== ' '){
                temp.reverse();
                res.append(temp+" ");
                temp.delete(0,temp.length());

            }else{
                temp.append(s.charAt(i));
            }
        }
        temp.reverse();
        res.append(temp);
        return res.toString();
    }
}
