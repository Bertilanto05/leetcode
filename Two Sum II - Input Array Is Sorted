class Solution {
    public int[] twoSum(int[] numbers, int target) {
        int n = numbers.length; 
        for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++)
            {   
                if(numbers[i]+numbers[j] == target)
                {
                    return new int[]{i+1,j+1};
                }
            }
        }
        return new int[]{};
    }
}
//// another solution 
class Solution {
    public int[] twoSum(int[] a, int target) {
        int n = a.length; 
        int str = 0;
        int end = n-1;
        while(str<=end){
            if(a[str]+a[end]==target){
                return new int []{str+1,end+1};
            }else if( a[str]+a[end]< target){
                str++;
            }else{
                end--;
            }
        } 
        
        return new int[]{-1,-1};
    }
}
